# ClaimCraft BD Environment Configuration Example
# Copy to .env for local development. NEVER commit .env with real secrets!

# Application mode: development | staging | production
APP_ENV=development
APP_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-key

# Server settings
HOST=127.0.0.1
PORT=8000
WEB_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# Backend API URL for Web BFF
BACKEND_API_URL=http://127.0.0.1:8000

# AI Provider Credentials (Groq LLaMA 3.3 & Google Gemini)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_STRONG=

# Google Cloud STT V2 Credentials (bn-BD chirp_2)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_STT_REGION=asia-southeast1

# Database (PostgreSQL + pgvector / Supabase)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/claimcraft_bd
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage Buckets (quarantine, evidence, exports, policy)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage

# Redis & Celery (async worker queue)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Embeddings & Lexical Retrieval
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
KNOWLEDGE_RELEASE_DIR=./knowledge/manifests

