graphify-out/graph.json merge=graphify
*.pdf binary
*.png binary
*.jpg binary
*.wav binary
*.ttf binary
# Fixture hashes include the original CRLF bytes on Windows.
docs/qa/fixtures/* -text whitespace=cr-at-eol
# Captured CLI logs retain their original whitespace and line endings.
docs/qa/evidence/*.txt -text whitespace=-blank-at-eol,-space-before-tab
